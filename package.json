{
  "author": "jamuhl",
  "name": "i18next-conv",
  "description": "converts .mo and .po files to i18next's json format and vice versa.",
  "keywords": [
    "i18next",
    "gettext"
  ],
  "version": "17.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "i18next-conv": "bin/index.js"
  },
  "files": [
    "bin",
    "lib",
    "index.js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/i18next/i18next-gettext-converter.git"
  },
  "license": "SEE LICENSE IN LICENSE.MD",
  "scripts": {
    "lint": "eslint --cache .",
    "test": "node --test --import ./test/setup.js",
    "cover": "c8 npm test"
  },
  "dependencies": {
    "@postalsys/gettext": "^4.1.1",
    "colorette": "^2.0.20",
    "commander": "^15.0.0",
    "gettext-converter": "^1.3.3",
    "gettext-parser": "^9.1.1",
    "p-from-callback": "^4.0.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.4",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mocha": "^11.3.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^65.0.1",
    "eslint-plugin-yml": "^3.6.0",
    "prettier": "3.9.6"
  }
}
